# Copy to .env and fill in. .env is gitignored - it never gets committed.

# --- Snowflake (from https://signup.snowflake.com , free 30-day trial) ---
# ACCOUNT is the bit before .snowflakecomputing.com in your login URL,
# e.g. https://abc12345.us-west-2.snowflakecomputing.com  ->  abc12345.us-west-2
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=WAITING_ROOM
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# --- Google AI (from https://aistudio.google.com/apikey , free tier) ---
GEMINI_API_KEY=
